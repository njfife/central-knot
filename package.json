{
  "name": "central-knot",
  "version": "0.3.0",
  "private": true,
  "description": "Sees and shares user-wide Claude Code and Copilot CLI skills",
  "type": "module",
  "main": "dist/main.cjs",
  "engines": { "node": ">=24.9.0" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test": "tsc --noEmit && node --test tests/*.test.ts",
    "package:mac": "npm run build && node scripts/package-mac.mjs",
    "smoke:mac": "npm run build && electron . --smoke-test",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": { "yaml": "2.9.1" },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@types/node": "26.6.6",
    "electron": "45.2.3",
    "esbuild": "0.28.2",
    "lucide-static": "1.70.0",
    "typescript": "7.0.2"
  }
}
